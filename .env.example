# API Principal (groq, gemini ou ollama)
AI_PROVIDER=groq

# Chave da API Groq (recomendado - https://console.groq.com)
GROQ_API_KEY=

# Chave da API Google Gemini (opcional - https://aistudio.google.com)
GEMINI_API_KEY=

# Modelo e URL do Ollama (usado quando AI_PROVIDER=ollama)
OLLAMA_MODEL=llama3
OLLAMA_URL=http://localhost:11434

# Idioma padrão (pt-BR ou en-US)
LANGUAGE=pt-BR

# Nome do assistente
ASSISTANT_NAME=DarkSON

# Nome do usuário (para saudação personalizada)
USER_NAME=Usuario

# API Weather (opcional - https://openweathermap.org/api)
WEATHER_API_KEY=

# API News (opcional - https://newsapi.org)
NEWS_API_KEY=

# Motor TTS: "edge" (neural, recomendado) ou "sapi" (Windows)
TTS_ENGINE=edge
# Voz masculina (padrao): pt-BR-AntonioNeural
TTS_VOICE=pt-BR-AntonioNeural

# Servidor web (apenas localhost por defeito)
DARKSON_HOST=127.0.0.1
DARKSON_PORT=5000
# Token para /api/executar (PowerShell remoto). Obrigatorio para essa rota.
DARKSON_API_TOKEN=

# Nuvem (Render/Railway/Heroku)
# DARKSON_HOST=0.0.0.0          # aceitar conexoes externas
# DARKSON_DATA_DIR=/var/data     # disco persistente
# DARKSON_WHISPER_MODEL=base     # modelo de transcricao: tiny/base/small/medium
# DARKSON_ALLOW_ORIGINS=https://darkson-ia.onrender.com  # origens CORS permitidas (separadas por virgula)

# API Replicate (para geração de imagens - https://replicate.com)
REPLICATE_API_KEY=
